PANDA_ENV=dev
# The identity database; the merchant database is created by the initdb script
# in deploy/compose/dev/initdb/.
POSTGRES_DB=panda_identity
POSTGRES_USER=panda
POSTGRES_PASSWORD=replace-me
# Shared fallback: services that own no database (the gateway) read this one.
DATABASE_URL=postgres://panda:replace-me@localhost:5432/panda_identity?sslmode=disable
# Each owning service reads its own; a blank value falls back to DATABASE_URL.
USER_DATABASE_URL=postgres://panda:replace-me@localhost:5432/panda_identity?sslmode=disable
MERCHANT_DATABASE_URL=postgres://panda:replace-me@localhost:5432/panda_merchant?sslmode=disable
# Connections each service instance may open. Pinned rather than left to pgx's
# max(4, NumCPU) so the arithmetic is checkable:
#
#     DB_POOL_MAX_CONNS × (services with a database) × (replicas) < max_connections
#
# With the default 10 and two owning services, one replica wants 20 and the
# stock Postgres max_connections=100 has room for five. Raise max_connections in
# step with replicas; the moment the sum crosses it, every service reports
# "too many clients" at once, not just the one that overshot.
#
# A per-DSN pool_max_conns is honored when this is blank, so either place works.
# An unparseable or non-positive value is an error, not a silent fallback —
# starting with a connection count nobody chose only shows up under load.
DB_POOL_MAX_CONNS=10
# Applies the service's migration set during startup. Production runs migrations
# out of band, so this stays false there.
DB_MIGRATE_ON_START=false
# etcd endpoints for service discovery. Empty means the no-op registry: services
# run without registering, which is how local stacks start. A value that is set
# but unreachable is NOT treated as empty — the service refuses to start rather
# than serve unregistered.
# ETCD_ENDPOINTS is still accepted as a deprecated alias.
REGISTRY_ENDPOINT=http://etcd:2379
RABBITMQ_URL=amqp://user:replace-me@rabbitmq:5672/
RABBITMQ_USER=user
RABBITMQ_PASSWORD=replace-me
# The topic exchange every event is published to, and the pattern this service's
# queue binds. A blank routing key binds "#" (everything) — an empty binding
# would strand every event on a topic exchange.
RABBITMQ_EXCHANGE=panda.events
RABBITMQ_ROUTING_KEY=
# Only services that consume need this. Publishers (merchant-service's outbox
# relay) work without it and never declare a queue.
RABBITMQ_QUEUE=
# Failed deliveries are retried this many times before they are rejected into the
# dead-letter queue. 0 disables retries — but rejections then still dead-letter
# rather than vanish, because the queue keeps its x-dead-letter-exchange.
RABBITMQ_RETRY_LIMIT=5
# Where rejected messages end up. Both default to panda.events.dlx / .dlq; set
# them blank to keep the defaults. They exist so a poison message is inspectable
# and replayable instead of silently dropped.
RABBITMQ_DLX=
RABBITMQ_DLQ=
# NOTE when adding the dead letter topology to a queue that already exists: the
# x-dead-letter-exchange argument is part of the queue's identity, and RabbitMQ
# rejects a redeclare that changes it (406 PRECONDITION_FAILED). On an existing
# broker, either delete the queue first or apply the arguments with a policy.
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
TEMPO_ENDPOINT=tempo:4317
OPENSEARCH_ENDPOINT=http://opensearch:9200
PROMETHEUS_ENDPOINT=0.0.0.0:8889
# What the services actually read. A blank value means the no-op providers: no
# exporter, no network activity, and the tracing/metrics middleware instruments
# nothing. Point it at otel-collector's OTLP gRPC receiver to turn both on.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

# Redis carries exactly two things: the policy-change broadcast that keeps every
# user-service replica's Casbin snapshot current, and the rate-limit window the
# gateway counts against. It never caches authorization decisions — those are
# re-read live on every request. An empty REDIS_ADDR is supported: the broadcast
# degrades to "this instance only" and rate limiting falls back to an in-process
# token bucket (so the budget becomes per-replica instead of global).
#
# Only user-service (broadcast) and gateway-service (rate limit) dial this.
# merchant-service does not, and an unreachable Redis no longer stops it from
# starting — so a Redis maintenance window costs admin permission propagation
# and per-replica rate accuracy, not the merchant domain.
REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
# Gateway edge rate limiting, per client IP. Auth endpoints get their own,
# tighter budget because that is where credential stuffing lands.
# RATE_LIMIT_ENABLED=false turns the whole thing off.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=600
RATE_LIMIT_AUTH_PER_MINUTE=30
# Which peers may speak for the client in X-Forwarded-For, as a comma-separated
# list of CIDRs. Empty means "trust nobody" and keys every request on
# RemoteAddr — correct when clients reach the gateway directly.
#
# Set this as soon as a load balancer sits in front of the gateway. Without it
# every request arrives with the LB's address as RemoteAddr, so the whole site
# shares one 600/min bucket and everyone gets 429 together.
# TRUSTED_PROXY_CIDRS=10.0.0.0/8,192.168.0.0/16
#
# Only hops from these ranges are walked, right to left, and the first
# untrusted address wins — so a client that forges X-Forwarded-For still cannot
# pick its own bucket. Never use 0.0.0.0/0 here: that trusts every peer.
TRUSTED_PROXY_CIDRS=
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=panda-v2
ACCOUNT_SERVICE_URL=http://account-service:8080
USER_SERVICE_URL=http://user-service:8080
MERCHANT_SERVICE_URL=http://merchant-service:8080
# Static internal gRPC endpoints, used until service discovery is enabled.
# user-service calls merchant-service and vice versa, so each needs its PEER's
# address; a service's own gRPC listener is GRPC_ADDR.
USER_GRPC_ADDR=user-service:9090
MERCHANT_GRPC_ADDR=merchant-service:9090
# Shared service token for internal gRPC calls, in both directions.
MERCHANT_INTERNAL_TOKEN=replace-with-at-least-32-byte-service-token
# Ownership timeout: 1000..30000 milliseconds.
MERCHANT_OWNERSHIP_TIMEOUT_MS=5000
GATEWAY_ADDR=:8080
GATEWAY_REQUEST_TIMEOUT_MS=10000
# The upload route gets its own, larger budget instead of the 10s every other
# route is held to: it covers the client's upload AND the write to OSS. 10MiB at
# 1Mbps upstream is ~80s, so 60s would produce a steady stream of 504s. Keep it
# above merchant-service's HTTP_TIMEOUT_MS — this is the outer of the two.
GATEWAY_UPLOAD_TIMEOUT_MS=120000
COFFEE_MACHINE_SERVICE_URL=http://coffee-machine-service:8080
# Each service's own listeners. In containers these are the ports the service
# name resolves to; the gRPC ones are also what gets registered for discovery.
HTTP_ADDR=:8080
GRPC_ADDR=:9090
# Whole-request timeout: kratos installs it around the request, body included, so
# it also bounds a single upload rather than one step of it. Empty means the code
# default — 5s for every service, 90s for merchant-service, because a 10MiB upload
# cannot finish in 5s. The three budgets layer, outer to inner: gateway upload
# 120s > merchant-service 90s > the OSS SDK's 60s read/write.
HTTP_TIMEOUT_MS=
SERVICE_VERSION=0.1.0

# Image uploads are written to Alibaba Cloud OSS. The key names are the ones the
# legacy panda_serve stack already uses, so moving over is a straight copy of
# four lines — but only the names, never the values: put the real pair in your
# local, untracked .env. A completely missing block is a supported state —
# merchant-service starts normally and only the upload endpoint answers 503,
# naming exactly which of these is missing.
OSS_ACCESS_KEY=replace-me
OSS_SECRET_KEY=replace-me
# Bare endpoint, WITHOUT the bucket. Public object URLs are built from it as
# https://<bucket>.<endpoint>/<key> unless OSS_CNAME below is set.
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
OSS_BUCKET=replace-me
# Custom domain bound to the bucket. Set it and object URLs go through that domain
# instead; leave it empty to derive the base from OSS_ENDPOINT. Deliberately the
# only name for this setting — the legacy CDN_URL meant the same thing.
OSS_CNAME=
# Object key prefix. This is what keeps v2's objects apart from the legacy site's
# inside one bucket. Point it at the legacy prefix only if you mean to reuse
# those objects.
UPLOAD_PATH=panda-v2
# Per-file limit: 10MiB. The ceiling enforced in code is 64MiB, because a larger
# body cannot finish inside GATEWAY_UPLOAD_TIMEOUT_MS — see the note above.
UPLOAD_MAX_FILE_SIZE=10485760
# Kept only so a copied legacy config still loads. The uploader always uses
# content-addressed md5 keys — a key built from the client filename can escape
# UPLOAD_PATH — so false is ignored, with a warning at startup.
UPLOAD_USE_MD5=true

# Development account initialization is disabled by default and only works with PANDA_ENV=dev.
# Set passwords through your local environment; never commit real values.
DEV_ACCOUNT_INIT_ENABLED=false
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=
DEV_MERCHANT_USERNAME=merchant
DEV_MERCHANT_PASSWORD=
