PANDA_ENV=dev
POSTGRES_DB=panda
POSTGRES_USER=panda
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgres://panda:replace-me@localhost:5432/panda?sslmode=disable
ETCD_ENDPOINTS=http://etcd:2379
RABBITMQ_URL=amqp://user:replace-me@rabbitmq:5672/
RABBITMQ_USER=user
RABBITMQ_PASSWORD=replace-me
OPENSEARCH_JAVA_OPTS=-Xms512m -Xmx512m
TEMPO_ENDPOINT=tempo:4317
OPENSEARCH_ENDPOINT=http://opensearch:9200
PROMETHEUS_ENDPOINT=0.0.0.0:8889
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-me

REDIS_ADDR=
REDIS_PASSWORD=
REDIS_DB=0
JWT_SECRET=replace-with-a-long-random-secret
JWT_ISSUER=panda-v2
ACCOUNT_SERVICE_URL=http://account-service:8080
USER_SERVICE_URL=http://user-service:8080
MERCHANT_SERVICE_URL=http://merchant-service:8080

# Development account initialization is disabled by default and only works with PANDA_ENV=dev.
# Set passwords through your local environment; never commit real values.
DEV_ACCOUNT_INIT_ENABLED=false
DEV_ADMIN_USERNAME=admin
DEV_ADMIN_PASSWORD=
DEV_MERCHANT_USERNAME=merchant
DEV_MERCHANT_PASSWORD=
