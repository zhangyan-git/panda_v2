# One Dockerfile for both web apps.
#
# The build context is the REPOSITORY ROOT: the apps are pnpm workspace members
# and import from packages/*, so the install needs the workspace root, the
# lockfile, and every member's manifest.
#
#   docker build -f deploy/docker/Dockerfile.web \
#     --build-arg APP=admin-web \
#     -t panda/admin-web .
#
# APP is the workspace directory name: admin-web or merchant-web.

ARG NODE_IMAGE=node:20-alpine
ARG NGINX_IMAGE=nginx:1.27-alpine

FROM ${NODE_IMAGE} AS builder

ARG APP
RUN test -n "${APP}" || { echo "APP build-arg is required" >&2; exit 1; }

# corepack reads the packageManager field in package.json and runs that exact
# pnpm. Without it the image would build with whatever pnpm was latest, and a
# pnpm major newer than the lockfile's version either fails
# --frozen-lockfile or silently rewrites the lockfile inside the image.
RUN corepack enable

WORKDIR /src

# Manifests first: installing is the slowest step and the one that changes
# least, so it should not be invalidated by an edit to a component. Every
# workspace member's package.json has to be here -- pnpm resolves the workspace
# before it will install anything.
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY admin-web/package.json ./admin-web/
COPY merchant-web/package.json ./merchant-web/
COPY packages/api/package.json ./packages/api/
COPY packages/ui/package.json ./packages/ui/

# --frozen-lockfile fails the build rather than resolving new versions: an
# image that does not match the committed lockfile is not reproducible, and
# finding that out at deploy time is too late.
RUN --mount=type=cache,target=/pnpm-store \
    pnpm config set store-dir /pnpm-store && \
    pnpm install --frozen-lockfile

COPY . .

RUN --mount=type=cache,target=/pnpm-store pnpm --filter "${APP}" build

FROM ${NGINX_IMAGE}

# The config is the same for both apps; only the bundle differs. It carries
# client_max_body_size and proxy_read_timeout, which the API needs and nginx's
# defaults get wrong.
COPY deploy/docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /src/${APP}/dist /usr/share/nginx/html

EXPOSE 80

# No healthcheck: nginx:alpine has wget, but the check that matters is the load
# balancer asking for a real page, not whether a process is resident.
