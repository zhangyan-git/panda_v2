# One Dockerfile for all the Go services.
#
# Deliberately no `# syntax=` directive: it makes every build resolve and pull
# an extra frontend image, which is a hard failure on a builder without registry
# access, in exchange for features this file does not use. RUN --mount is part
# of the built-in BuildKit frontend, so the pinned frontend buys nothing here.
#
# The build context is the REPOSITORY ROOT, not backend/. This is not a
# preference: backend/services/*/go.mod reach their siblings with relative
# replace directives (../../ for backend, ../../../contracts and ../../../migrations),
# so anything less than the whole repository cannot resolve them.
#
#   docker build -f deploy/docker/Dockerfile.backend \
#     --build-arg SERVICE=user-service \
#     -t panda/user-service .
#
# SERVICE is the module directory name. Every service keeps its main package in
# cmd, so CMD's default is the answer for all of them; the ARG stays for the
# occasional second binary in the same module (user-service/cmd/seed). A wrong
# CMD fails the build loudly with "main module does not contain package".

# Both base images are ARGs so a builder that cannot reach the public registry
# can point them at a mirror. They are declared BEFORE the first FROM on
# purpose: an ARG declared inside a stage is not in scope for a later FROM, and
# the build fails with "base name should not be blank" -- which reads like a
# typo rather than a scoping rule.
ARG GO_IMAGE=golang:1.25
# Was gcr.io/distroless/static-debian12:nonroot. It changed because it cannot be
# pulled, not out of preference: the office CI runner's egress does not reach
# gcr.io (`dial tcp 142.250.107.82:443: i/o timeout`) or github.com, while
# Docker Hub works -- the golang:1.25 above is pulled from it.
#
# debian:bookworm-slim plus the two packages distroless used to supply is what
# the other projects in this registry already do (qituan-gateway, bianbot,
# newapi-rs). Going back to distroless is one value: point this ARG -- and
# RUNTIME_IMAGE in .gitea/workflows/build-and-push.yml -- at a copy of it.
ARG RUNTIME_IMAGE=debian:bookworm-slim

FROM ${GO_IMAGE} AS builder

ARG SERVICE
ARG CMD=./cmd
RUN test -n "${SERVICE}" || { echo "SERVICE build-arg is required" >&2; exit 1; }

WORKDIR /src

# Manifests before sources, so the dependency layer survives an edit to any .go
# file. The sibling go.mod files have to be here too: the replace directives
# point at them, and the module graph cannot be computed without them.
COPY backend/go.mod backend/go.sum ./backend/
COPY backend/services/${SERVICE}/go.mod backend/services/${SERVICE}/go.sum ./backend/services/${SERVICE}/
COPY contracts/go.mod contracts/go.sum ./contracts/
COPY migrations/go.mod migrations/go.sum ./migrations/

# The module cache is mounted rather than baked into a layer: it is downloaded
# during the build and should not be part of the image.
RUN --mount=type=cache,target=/go/pkg/mod \
    cd backend/services/${SERVICE} && go mod download

COPY backend/ ./backend/
COPY contracts/ ./contracts/
COPY migrations/ ./migrations/

# CGO off so the result is a static binary. That is what makes the runtime image
# a choice rather than a constraint -- the binary does not care whether the base
# has a libc, which is how distroless/static and debian:bookworm-slim are both
# usable without rebuilding anything.
#
# -trimpath keeps the build directory out of stack traces and the binary's
# embedded file paths, so an image built here and one built on a laptop produce
# the same binary.
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    cd backend/services/${SERVICE} && \
    CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/app "${CMD}"

FROM ${RUNTIME_IMAGE}

# ca-certificates for outbound TLS (the OSS client) and tzdata for the
# local-time log fields. distroless/static carried both; a bare debian carries
# neither, so they are installed here rather than assumed.
#
# The apt mirror is part of that pattern, not a speed tweak: deb.debian.org is
# not reachable from these builders either. DEBIAN_FRONTEND is inline because
# tzdata's postinst is a debconf prompt, and a build that stops to ask a
# question in a CI log looks like a hang rather than a failure.
RUN sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list.d/debian.sources 2>/dev/null || true; \
    sed -i 's|deb.debian.org|mirrors.aliyun.com|g' /etc/apt/sources.list 2>/dev/null || true; \
    DEBIAN_FRONTEND=noninteractive apt-get update && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends ca-certificates tzdata && \
    rm -rf /var/lib/apt/lists/*

# Numeric, because 65532 is distroless/static's `nonroot` and debian has no such
# user. The number is the part that survives a change of base image; a name
# would have to exist in every one of them.
USER 65532:65532

# The migrations are embedded into the binary (migrations.Identity and friends
# are embed.FS), so no .sql files are shipped -- DB_MIGRATE_ON_START works in
# this image without a mounted directory.
COPY --from=builder /out/app /app

# Documentation only; the real addresses come from HTTP_ADDR and GRPC_ADDR.
EXPOSE 8080 9090

# No HEALTHCHECK. Probes are the load balancer's job -- /livez and /readyz on
# the HTTP port, which is also the only version that answers "is THIS replica
# able to serve", rather than "did a process start". The base image having a
# shell now does not change that; it only removes the reason it used to be
# impossible.
ENTRYPOINT ["/app"]
